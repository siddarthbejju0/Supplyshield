{
  "name": "supplyshield-ai",
  "version": "1.0.0",
  "description": "SupplyShield AI — Interactive Supply Chain Risk Intelligence & Decision Support Platform",
  "private": true,
  "scripts": {
    "dev:backend": "python backend/run.py",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "test:backend": "python -m pytest backend/tests/ -v",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
